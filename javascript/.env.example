# ==============================================================================
# kLog JavaScript SDK — Plantilla de Variables de Entorno (Desarrollo y Pruebas)
# Copiar este archivo a .env para ejecutar ejemplos y suites de prueba locales.
# ==============================================================================

# --- Conexión con el Servidor kLog ---
KLOG_URL=http://localhost:3100

# --- Identificadores de Organización y Aplicación (UUIDv7) ---
KLOG_TENANT_ID=018e3a2b-7c4d-7f91-88b1-3e129f123456
KLOG_APPLICATION_ID=018e3a2b-87cf-7922-8114-ba83726410cc

# --- API Token de Ingesta (Rol Device klog_<prefix>_<secret>) ---
KLOG_TOKEN=klog_replace_me_with_a_real_token_from_console________________