VITE_KLOG_APPLICATION_ID=018e3a2b-87cf-7922-8114-ba83726410cc

# --- API Token de Ingesta (Rol Device) ---
VITE_KLOG_TOKEN=klog_replace_me_with_a_real_token_from_console________________
