{
  "name": "@kriverdevice/klog-web",
  "version": "0.1.0",
  "description": "Official browser REST ingest client for kLog",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/klog-platform/klog-sdks.git",
    "directory": "javascript/packages/web"
  },
  "homepage": "https://klog.krisskira.com/docs/sdks",
  "keywords": [
    "klog",
    "telemetry",
    "observability",
    "logging",
    "ingest",
    "sdk",
    "events",
    "browser",
    "react",
    "vue",
    "angular"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@kriverdevice/klog-core": "0.1.0"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vitest": "^5.0.3"
  },
  "bugs": {
    "url": "https://github.com/klog-platform/klog-sdks/issues"
  }
}
