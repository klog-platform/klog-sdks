{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "build": {
      "dependsOn": ["lint", "^build"],
      "outputs": ["dist/**"]
    },
    "@kriverdevice/klog-sdk-java#build": {
      "dependsOn": ["lint", "^build"],
      "outputs": ["target/**"]
    },
    "@kriverdevice/klog-sdk-esp#build": {
      "dependsOn": ["lint", "^build"],
      "outputs": ["test/host/klog.o"]
    },
    "@kriverdevice/klog-sdk-go#build": {
      "dependsOn": ["lint", "^build"],
      "outputs": []
    },
    "@kriverdevice/klog-sdk-php#build": {
      "dependsOn": ["lint", "^build"],
      "outputs": []
    },
    "@kriverdevice/klog-sdk-python#build": {
      "dependsOn": ["lint", "^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": []
    }
  }
}
