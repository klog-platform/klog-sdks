{
  "name": "kriverdevice/klog-sdk-php",
  "description": "Cliente oficial de ingesta REST para kLog en PHP",
  "type": "library",
  "license": "Apache-2.0",
  "homepage": "https://klog.krisskira.com/docs/sdks?lang=en",
  "keywords": [
    "klog",
    "telemetry",
    "logging",
    "observability",
    "sdk",
    "ingest",
    "events",
    "php"
  ],
  "authors": [
    {
      "name": "kLog",
      "email": "soporte@krisskira.com"
    }
  ],
  "support": {
    "issues": "https://github.com/klog-platform/klog-sdks/issues",
    "source": "https://github.com/klog-platform/klog-sdks"
  },
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "Klog\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Klog\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit"
  }
}
